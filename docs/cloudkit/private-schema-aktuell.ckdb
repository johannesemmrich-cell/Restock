DEFINE SCHEMA

    RECORD TYPE CD_FeedbackItem (
        CD_context      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isResolved   INT64 QUERYABLE SORTABLE,
        CD_priority     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text         STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PurchaseRecord (
        CD_actualPrice    DOUBLE QUERYABLE SORTABLE,
        CD_date           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_item           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_itemName       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_quantityAmount DOUBLE QUERYABLE SORTABLE,
        CD_storeName      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit           STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ShoppingItem (
        CD_addedBy                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_addedDate                   TIMESTAMP QUERYABLE SORTABLE,
        CD_assignedTo                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_category                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryManuallySet         INT64 QUERYABLE SORTABLE,
        CD_completedBy                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_completedDate               TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedPrice              DOUBLE QUERYABLE SORTABLE,
        CD_estimatedPriceIsAutoDerived INT64 QUERYABLE SORTABLE,
        CD_hasPhoto                    INT64 QUERYABLE SORTABLE,
        CD_id                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isCompleted                 INT64 QUERYABLE SORTABLE,
        CD_isUrgent                    INT64 QUERYABLE SORTABLE,
        CD_lastModified                TIMESTAMP QUERYABLE SORTABLE,
        CD_name                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photoData                   BYTES QUERYABLE SORTABLE,
        CD_photoData_ckAsset           ASSET,
        CD_photoLastModified           TIMESTAMP QUERYABLE SORTABLE,
        CD_priceSource                 STRING,
        CD_priceSourceDate             TIMESTAMP,
        CD_quantity                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_quantityAmount              DOUBLE QUERYABLE SORTABLE,
        CD_quantitySource              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_store                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit                        STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Store (
        CD_categories              BYTES QUERYABLE SORTABLE,
        CD_categoryAssignmentDates BYTES QUERYABLE SORTABLE,
        CD_categoryAssignments     BYTES QUERYABLE SORTABLE,
        CD_colorHex                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_countryCode             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customCategoryDates     BYTES QUERYABLE SORTABLE,
        CD_customCategoryEmojis    BYTES QUERYABLE SORTABLE,
        CD_emoji                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isActive                INT64 QUERYABLE SORTABLE,
        CD_isCustom                INT64 QUERYABLE SORTABLE,
        CD_isPaused                INT64 QUERYABLE SORTABLE,
        CD_itemOrderMap            BYTES QUERYABLE SORTABLE,
        CD_learnedPriceDates       BYTES QUERYABLE SORTABLE,
        CD_learnedPriceOrigins     BYTES,
        CD_learnedPriceUnits       BYTES QUERYABLE SORTABLE,
        CD_learnedPrices           BYTES QUERYABLE SORTABLE,
        CD_name                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortIndex               INT64 QUERYABLE SORTABLE,
        CD_stationConfigJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_visitsPerWeek           DOUBLE QUERYABLE SORTABLE,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TodoItem (
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isCompleted  INT64 QUERYABLE SORTABLE,
        CD_notes        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title        STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CommunityPrice (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        chain           STRING QUERYABLE SEARCHABLE SORTABLE,
        clientID        STRING QUERYABLE SEARCHABLE SORTABLE,
        itemKey         STRING QUERYABLE SEARCHABLE SORTABLE,
        observedAt      TIMESTAMP QUERYABLE SORTABLE,
        price           DOUBLE QUERYABLE SORTABLE,
        unit            STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedItemPhoto (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        photoAsset      ASSET,
        shareID         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedStore (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        assignmentsJSON STRING QUERYABLE SEARCHABLE SORTABLE,
        categoriesJSON  STRING QUERYABLE SEARCHABLE SORTABLE,
        deletedJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        itemsJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        membersJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        ownerDevice     STRING QUERYABLE SEARCHABLE SORTABLE,
        pricesJSON      STRING QUERYABLE SEARCHABLE SORTABLE,
        storeColorHex   STRING QUERYABLE SEARCHABLE SORTABLE,
        storeEmoji      STRING QUERYABLE SEARCHABLE SORTABLE,
        storeName       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
